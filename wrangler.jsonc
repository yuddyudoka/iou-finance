{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "iou-finance",
  "main": "./worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/cms-images/*"]
  },
  "r2_buckets": [
    {
      "binding": "CMS_BUCKET",
      "bucket_name": "iou-finance-cms"
    }
  ],
  "observability": {
    "enabled": true
  }
}
