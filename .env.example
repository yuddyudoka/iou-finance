# Copy these values into .env. Keep the real .env file private.
# Server-only admin access. Use a long password and a separate random session secret.
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret

# Server-side application email endpoint.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=IOU Finance <applications@your-verified-domain.com>
APPLICATION_RECIPIENT_EMAIL=applications@ioufinanceltd.com
